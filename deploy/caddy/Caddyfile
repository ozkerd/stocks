# Caddyfile for stocks.primerllm.com
# Automatic HTTPS via Let's Encrypt / Cloudflare Origin CA

stocks.primerllm.com {
    reverse_proxy 127.0.0.1:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/stocks.primerllm.com.log
    }
}
